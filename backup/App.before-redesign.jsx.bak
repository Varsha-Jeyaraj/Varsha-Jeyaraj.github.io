              </div>
            ))}
          </div>

          <div style={{ marginTop: "34px" }}>
            <p
              style={{
                fontFamily: "'JetBrains Mono', monospace",
                fontSize: "11px",
                color: t.accentLabel,
                marginBottom: "12px",
                letterSpacing: "0.08em",
